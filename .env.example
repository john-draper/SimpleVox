# ====================================================================
# SimpleVox — Environment Variables
# ====================================================================
# Copy this file to ".env" and edit as needed.
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (macOS/Linux)
#
# SimpleVox works out of the box WITHOUT any of these — they're optional
# tuning knobs.
# ====================================================================

# ---- WhisperX transcription ----
# Device: 'cuda' for GPU (recommended) or 'cpu' for fallback
# WHISPER_DEVICE=cuda
# Model size: 'tiny', 'base', 'small' (default), 'medium', 'large-v3'
# WHISPER_MODEL=small

# ---- Video muxing ----
# When set to "1", the original video stream is re-encoded to H.264 instead of
# stream-copied. Slower but can fix players/containers that choke on a direct copy.
# VIDEO_REENCODE=1